DATABASE_URL="sqlite+aiosqlite:///./observatorio.db"
# Para PostgreSQL (psycopg 3 em modo assíncrono):
# DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/observatorio"
ENVIRONMENT="development"

# Credenciais dos provedores de LLM (lidas pelos SDKs a partir do ambiente)
OPENAI_API_KEY=""

# Modelos por nível no formato "provedor:modelo" (init_chat_model do LangChain)
# e parâmetros extras do modelo em JSON.
LLM_FAST_MODEL="openai:gpt-6-luna"
LLM_FAST_MODEL_KWARGS='{"reasoning_effort": "low"}'
LLM_MEDIUM_MODEL="openai:gpt-6-luna"
LLM_MEDIUM_MODEL_KWARGS='{"reasoning_effort": "low"}'
LLM_ADVANCED_MODEL="openai:gpt-6-luna"
LLM_ADVANCED_MODEL_KWARGS='{"reasoning_effort": "low"}'
