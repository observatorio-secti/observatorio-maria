DATABASE_URL="sqlite+aiosqlite:///./observatorio.db"
# Para PostgreSQL (psycopg 3 em modo assíncrono):
# DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/observatorio"
ENVIRONMENT="development"
# Página de demonstração em /demo
DEMO_ENABLED=true

# Fontes de dados do catálogo: cada fonte guarda apenas o NOME da variável
# com a URL de conexão (nunca a URL). A conexão é aberta em modo somente leitura.
FOMENTO_DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/fomento"
# Verificação periódica de defasagem do catálogo, em segundos (0 desliga).
# Roda também ao iniciar a API e só lê o schema das fontes ativas.
CATALOG_CHECK_INTERVAL_SECONDS=3600

# Limites para consultas a dados e agente da Maria
QUERY_MAX_ROWS=100
QUERY_TIMEOUT_SECONDS=15
QUERY_MAX_PER_CALL=4
# Custo estimado máximo de consulta via EXPLAIN no PostgreSQL (0 desliga)
QUERY_MAX_ESTIMATED_COST=50000
MARIA_AGENT_MAX_MODEL_CALLS=3
# Teto de tokens acumulados por conversa (0 desliga)
CONVERSATION_TOKEN_CEILING=100000

# Credenciais dos provedores de LLM (lidas pelos SDKs a partir do ambiente)
OPENAI_API_KEY=""

# Modelos por nível no formato "provedor:modelo" (init_chat_model do LangChain)
# e parâmetros extras do modelo em JSON.
LLM_FAST_MODEL="openai:gpt-6-luna"
LLM_FAST_MODEL_KWARGS='{"reasoning_effort": "low"}'
LLM_MEDIUM_MODEL="openai:gpt-6-luna"
LLM_MEDIUM_MODEL_KWARGS='{"reasoning_effort": "low"}'
LLM_ADVANCED_MODEL="openai:gpt-6-luna"
LLM_ADVANCED_MODEL_KWARGS='{"reasoning_effort": "low"}'

# Observabilidade (OpenTelemetry). Suba a stack com:
#   docker compose -f observability/compose.yaml up -d
# Sem a stack, use OTEL_SDK_DISABLED=true.
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME="observatorio-maria"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# Oculta o conteúdo das mensagens nos traces (LGPD)
OPENINFERENCE_HIDE_INPUTS=false
OPENINFERENCE_HIDE_OUTPUTS=false
