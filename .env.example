DATABASE_URL="sqlite+aiosqlite:///./observatorio.db"
# Para PostgreSQL (psycopg 3 em modo assíncrono):
# DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/observatorio"
ENVIRONMENT="development"
# Página de demonstração em /demo
DEMO_ENABLED=true

# Fontes de dados do catálogo: cada fonte guarda apenas o NOME da variável
# com a URL de conexão (nunca a URL). A conexão é aberta em modo somente leitura.
FOMENTO_DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/fomento"
# Banco de leitura do Simcc (em dev, o read_db do compose do simcc-etl).
# SIMCC_DATABASE_URL="postgresql+psycopg://user:password@localhost:5434/simcc"
# Verificação periódica de defasagem do catálogo, em segundos (0 desliga).
# Roda também ao iniciar a API e só lê o schema das fontes ativas.
CATALOG_CHECK_INTERVAL_SECONDS=3600
# Máximo de valores distintos para uma coluna de texto visível ter seus
# valores lidos da origem (acima disso é texto livre).
CATALOG_OBSERVED_VALUES_MAX=50
# Máximo de valores observados para uma coluna em "auto" listá-los no contexto
# do modelo (os demais continuam guardados para revisão na demo)
CATALOG_CONTEXT_VALUES_MAX=20

# Limites para consultas a dados e agente da Maria
QUERY_MAX_ROWS=100
QUERY_TIMEOUT_SECONDS=15
QUERY_MAX_PER_CALL=4
# Custo estimado máximo de consulta via EXPLAIN no PostgreSQL (0 desliga)
QUERY_MAX_ESTIMATED_COST=50000
MARIA_AGENT_MAX_MODEL_CALLS=6
# Consultas entre fontes (DuckDB em memória, por consulta): memória, threads e
# consultas simultâneas no processo
QUERY_FEDERATED_MEMORY_LIMIT=512MB
QUERY_FEDERATED_THREADS=2
QUERY_FEDERATED_MAX_CONCURRENT=2
# Perguntas por conversa; na seguinte, a API responde 429 (0 desliga)
CONVERSATION_MAX_QUESTIONS=10
# Teto opcional de tokens acumulados por conversa (0 desliga, padrão)
CONVERSATION_TOKEN_CEILING=0

# Credenciais dos provedores de LLM (lidas pelos SDKs a partir do ambiente)
OPENAI_API_KEY=""

# Modelos por nível no formato "provedor:modelo" (init_chat_model do LangChain)
# e parâmetros extras do modelo em JSON.
LLM_FAST_MODEL="openai:gpt-6-luna"
LLM_FAST_MODEL_KWARGS='{"reasoning_effort": "low"}'
LLM_MEDIUM_MODEL="openai:gpt-6-luna"
LLM_MEDIUM_MODEL_KWARGS='{"reasoning_effort": "low"}'
LLM_ADVANCED_MODEL="openai:gpt-6-luna"
LLM_ADVANCED_MODEL_KWARGS='{"reasoning_effort": "low"}'

# Observabilidade (OpenTelemetry). Suba a stack com:
#   docker compose -f observability/compose.yaml up -d
# Sem a stack, use OTEL_SDK_DISABLED=true.
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME="observatorio-maria"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# Oculta o conteúdo das mensagens nos traces (LGPD)
OPENINFERENCE_HIDE_INPUTS=false
OPENINFERENCE_HIDE_OUTPUTS=false

# Deploy em produção (compose.prod.yaml). Veja docs/deploy.md.
# O compose sobrescreve DATABASE_URL para usar o SQLite no volume maria_data.
MARIA_API_PORT=11309
# Rede do compose do fomento (docker network ls). Nessa rede, o banco do
# fomento responde pelo host "db":
#   FOMENTO_DATABASE_URL="postgresql+psycopg://maria_leitura:senha@db:5432/fomento"
FOMENTO_NETWORK="observatorio-fomento_default"
# Rede externa do Simcc (padrão simcc-network). Nela, o banco de leitura
# responde pelo host "read_db":
#   SIMCC_DATABASE_URL="postgresql+psycopg://maria_leitura:senha@read_db:5432/simcc"
# SIMCC_NETWORK="simcc-network"
